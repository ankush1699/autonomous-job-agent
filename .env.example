# Copy to .env and fill in real values. .env is gitignored — never commit it.

# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Cost optimization (strongly recommended — see README "Setup") ─────────────
# Free at console.groq.com. Without this, the cheap tier silently falls back
# to paid Claude Haiku for every should-apply/keyword/strategist/editor call.
GROQ_API_KEY=
# LLM_CHEAP_PROVIDER=groq        # override auto-detection: groq | ollama | anthropic
# OLLAMA_MODEL=llama3.1:8b
# SHOULD_APPLY_MIN_SCORE=75      # env DEFAULT for the single apply threshold; the web UI's Scraper tab "Min score" overrides it
# JD_CACHE_TTL_DAYS=0            # 0 = verdicts never expire

# ── Output locations ──────────────────────────────────────────────────────────
# OUTPUT_BASE_PATH=~/Documents/Resumes      # internal STATE: JD cache, seen-jobs, entries.json
# RESUME_OUTPUT_PATH=~/Documents/Resumes    # where tailored resume/CL folders actually get written
# If your path has leading/trailing spaces or other characters .env parsers
# might trim, wrap it in quotes: RESUME_OUTPUT_PATH="/path/with a space "

# ── Web UI (server.py) ──────────────────────────────────────────────────────────
# Shared secret gating /api/* — anyone with this can trigger paid LLM calls.
APP_PASSWORD=
CORS_ORIGINS=*

# ── Scraper mode ──────────────────────────────────────────────────────────────
SERPAPI_KEY=
LINKEDIN_COOKIE=
GOOGLE_SHEETS_SPREADSHEET_ID=
JOB_SEARCH_KEYWORDS=software engineer
JOB_SEARCH_LOCATION=United States
JOB_SEARCH_REMOTE=true
JOB_RESULTS_PER_PLATFORM=20
JOB_SEARCH_HOURS_OLD=24
DICE_API_DELAY=2
SCRAPER_INTERVAL_HOURS=2
# MIN_ALIGNMENT_SCORE is retired (still honored as a fallback) — use SHOULD_APPLY_MIN_SCORE above
SPONSORSHIP_LOOKUP_ENABLED=false

# ── Notifications (optional) ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Unused (present in some configs, not required by the current pipeline) ────
# GOOGLE_API_KEY=
